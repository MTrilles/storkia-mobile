# Storkia Mobile — Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# This file documents environment-specific settings.
# Flutter reads baseUrl dynamically in api_service.dart (Platform.isAndroid).
#
# Android Emulator  → host machine localhost is at 10.0.2.2
# iOS Simulator     → host machine localhost is at 127.0.0.1
# Physical Device   → use your machine's actual local IP (e.g. 192.168.1.x)
# ─────────────────────────────────────────────────────────────────────────────

# API Configuration
API_BASE_URL_ANDROID=http://10.0.2.2:8000/api/v1
API_BASE_URL_IOS=http://127.0.0.1:8000/api/v1

# App Config
APP_NAME=Storkia
APP_ENV=local
APP_DEBUG=true
